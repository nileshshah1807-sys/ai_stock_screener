NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Brandfetch client identifier used in browser-visible logo URLs.
# Register at https://developers.brandfetch.com/ and never put a secret API key here.
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=your_brandfetch_client_id

# Optional request tracing for local performance diagnostics.
SCREENER_TRACE=0

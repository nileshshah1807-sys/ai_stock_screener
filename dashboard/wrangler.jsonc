{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cupel-dashboard",
  // Text vars set in the Cloudflare dashboard (JSM_*, TRIAL_GUARD_SALT) and secrets are not in this file;
  // without this a `wrangler deploy` would wipe the vars. Secrets survive either way.
  "keep_vars": true,
  // wrangler's esbuild would wrap functions in __name() helpers; next-themes sends one of them to the browser as
  // inline script text, where __name does not exist ("ReferenceError: __name is not defined", theme script dead).
  "keep_names": false,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // With routes set, wrangler turns the workers.dev address off unless told otherwise; Creed's smoke runs there.
  "workers_dev": true,
  // Production hostnames. Attached here so a deploy keeps them; wrangler adds a missing one and leaves an existing one alone.
  "routes": [
    { "pattern": "cupel.in", "custom_domain": true },
    { "pattern": "www.cupel.in", "custom_domain": true }
  ],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Run the Worker near the database (the Supabase project is in ap-northeast-1, Tokyo).
  // An explicit host, not "smart": Smart Placement needs traffic to learn and stayed
  // INSUFFICIENT_INVOCATIONS. Measured from Bengaluru: data pages' first byte fell
  // (RELIANCE 1977 -> 632 ms, screener 2016 -> 1121 ms); /login, with no database read, rose.
  "placement": { "hostname": "aeikzaubhepxjxqdhkjz.supabase.co" },
  "r2_buckets": [
    // Next's incremental cache (open-next.config.ts). Create it first: npx wrangler r2 bucket create cupel-next-cache
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "cupel-next-cache" },
    // Chart series and snapshot payloads (lib/market-data.ts), copied from Supabase Storage by workers; Storage stays the fallback.
    { "binding": "MARKET_DATA", "bucket_name": "market-data" }
  ],
  // Market data tables (lib/db/market-repository.ts), read only when TABLE_BACKEND names them.
  "d1_databases": [
    { "binding": "D1_CORE", "database_name": "cupel-core", "database_id": "48893af3-d137-4320-bea3-450ae9908d7f" },
    { "binding": "D1_EVIDENCE", "database_name": "cupel-evidence", "database_id": "40bd952e-00dd-4377-87c5-f336c1032ef2" },
    { "binding": "D1_HISTORY", "database_name": "cupel-history", "database_id": "4ba446d5-d2c0-4c0d-b0a8-603cb6a0351e" }
  ],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "cupel-dashboard" }]
}

REVERSE_DCF_RANKING_WEIGHT=0.10

TRANSCRIPT_SENTIMENT_ENABLED=True
REQUIRE_TRANSCRIPT_FOR_STRONG_BUY=False
TRANSCRIPT_MAX_EVIDENCE_AGE_DAYS=180
TRANSCRIPT_MIN_PRIORITY_SCORE=55
TRANSCRIPT_MAX_PRIORITY_RISK=60
TRANSCRIPT_FAIL_ON_ERROR=True
TRANSCRIPT_ENABLE_FINBERT=True
TRANSCRIPT_REQUIRE_FINBERT=True
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key


EMAIL_ENABLED=True
EMAIL_DELIVERY_METHOD=GMAIL_API
EMAIL_SENDER=nilesh.shah1807@gmail.com
EMAIL_RECEIVER=nilesh.shah1807@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
ATTACH_CSV=True
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_google_oauth_refresh_token
BREVO_API_KEY=your_brevo_api_key
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_TIMEOUT_SECONDS=30
SMTP_FORCE_IPV4=True

OUTPUT_DIR=/data/reports_advanced
YFINANCE_CACHE_DIR=/data/yfinance_cache
FUND_CACHE_MAX_AGE_DAYS=7
PRICE_CACHE_MAX_AGE_HOURS=18

SCHEDULE_TIME=09:00
SCHEDULE_TIMEZONE=Asia/Kolkata

# Which market this run screens: NSE (default) or US. Everything below that
# looks NSE-specific -- the timezone, the benchmark, the ticker suffix, the
# universe source -- takes its default from the market profile in
# screener/markets.py, so this one line switches all of them together.
MARKET=NSE
# US only: sp1500 (default), sp500 or all_listed. Ignored for NSE.
US_UNIVERSE_SOURCE=

SCAN_ALL_NSE=False
# Symbols for the SCAN_ALL_NSE=False smoke path, in the active market.
CUSTOM_WATCHLIST=RELIANCE,TCS,HDFCBANK,INFY,ICICIBANK
REVERSE_DCF_ENABLED=True
REVERSE_DCF_FORECAST_YEARS=5
REVERSE_DCF_DISCOUNT_RATE=0.11
REVERSE_DCF_TERMINAL_GROWTH=0.04
REVERSE_DCF_BASE_GROWTH=0.15
REVERSE_DCF_RANKING_WEIGHT=0.10

TRANSCRIPT_SENTIMENT_ENABLED=True
REQUIRE_TRANSCRIPT_FOR_STRONG_BUY=False
TRANSCRIPT_MAX_EVIDENCE_AGE_DAYS=180
TRANSCRIPT_MIN_PRIORITY_SCORE=55
TRANSCRIPT_MAX_PRIORITY_RISK=60
TRANSCRIPT_FAIL_ON_ERROR=True
TRANSCRIPT_ENABLE_FINBERT=True
TRANSCRIPT_REQUIRE_FINBERT=True
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Free NSE/SEBI red-flag evidence. Keep disabled until the Supabase schema has
# been applied and workers.red_flag_worker has populated the cache.
RED_FLAG_ENRICHMENT_ENABLED=False
VIGIL_BASE_URL=https://api.tigzig.com/vigil/v1
VIGIL_TIMEOUT_SECONDS=60
RED_FLAG_LOOKBACK_DAYS=365
RED_FLAG_STALE_AFTER_DAYS=7
